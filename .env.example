# Copy to backend/.env  — everything works offline in "mock" mode with no keys.
NEXUS_LLM_PROVIDER=mock            # mock | anthropic | gemini
NEXUS_ANTHROPIC_API_KEY=
NEXUS_ANTHROPIC_MODEL=claude-sonnet-4-6
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-2.5-flash   # check Google's current model list
NEXUS_EMBED_PROVIDER=hash          # hash | gemini
NEXUS_CORS_ORIGINS=http://localhost:5173
NEXUS_ABSTAIN_THRESHOLD=0.22
